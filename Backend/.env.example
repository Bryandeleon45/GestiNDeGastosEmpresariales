# Copia este archivo a .env y ajusta los valores
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=123456
PGDATABASE=GestionCadenadeProveedores

# Neon / PostgreSQL remoto (opcional; tiene prioridad sobre PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE)
# En Render usa la cadena "pooled" de Neon:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxxx-pooler.us-east-1.aws.neon.tech/GestionCadenadeProveedores?sslmode=verify-full
# PGDATABASE=GestionCadenadeProveedores
# PGPOOL_MAX=5
# PGSSL=false desactiva SSL (solo para PostgreSQL local sin TLS)

# Secreto para firmar los tokens JWT de sesión
# OBLIGATORIO: mínimo 32 caracteres aleatorios. Generar, por ejemplo, con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

PORT=4000

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:8443

# URL pública de la aplicación (se usa en los enlaces de los correos)
APP_URL=http://localhost:8443

# Entorno de ejecución (en producción: production)
# NODE_ENV=production

# Correo SMTP (Gmail) para envio de codigos de recuperacion
# SMTP_PASS debe ser una "contrasena de aplicacion" de Gmail (no la clave normal).
# Si SMTP_USER/SMTP_PASS quedan vacios, el backend usa MODO DESARROLLO:
# el codigo de recuperacion se imprime en la consola del backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gestion de Proveedores <no-reply@munipanajachel.gob.gt>"
SMTP_TEST_TO=

# WhatsApp (recuperacion de contrasena por mensaje)
# Mientras esten vacios, el envio funciona en MODO DESARROLLO (imprime en consola).
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
